# The checked-in, photo-verified dishes are the default catalogue.
VITE_MENU_SOURCE=csv

# Use VITE_MENU_SOURCE=preview only for the labelled fictional UI demo.
# Public files are resolved under Vite's BASE_URL, including repository subpaths.
VITE_MENU_CSV_FILES=["data/menu.csv"]
VITE_CANTEENS_URL=data/canteens.json
